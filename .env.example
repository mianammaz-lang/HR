# Database — Postgres connection string (Neon, Supabase, RDS, etc).
# Format: postgresql+asyncpg://<user>:<password>@<host>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# JWT — generate a strong random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# One-time admin seed (used only by the protected /api/admin/seed endpoint, see README)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_SECRET=replace-with-a-random-one-time-secret

# ERPNext (optional)
ERP_NEXT_URL=https://your-erpnext-instance.com
ERP_API_KEY=your_api_key
ERP_API_SECRET=your_api_secret

# OpenRouter AI (optional, used for AI scoring/parsing)
OPENROUTER_API_KEY=your_openrouter_api_key

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend — leave unset on Vercel (same-origin /api rewrite is used automatically)
NEXT_PUBLIC_API_URL=
